{
  "name": "projects/pucminas-507118/metrics/cloudrun_event_images_latency",
  "description": "Latência do Cloud Run Event-Images",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"event-images\"",
  "metricDescriptor": {
    "name": "custom.googleapis.com/cloudrun/event_images/latency",
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "s"
  },
  "valueExtractor": "EXTRACT(httpRequest.latency)",
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [0.1, 0.5, 1, 2, 5, 10]
    }
  }
}
